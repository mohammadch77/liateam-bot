  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3850",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
