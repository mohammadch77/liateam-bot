# Avina shop — warm the image cache (template). Asks the running shop (127.0.0.1:3861) for every picture size the
# pages use, one at a time, 1–3 s after each resize, at most IMAGES_WARM_MAX (300) per run, never 23:00–07:00 Tehran.
# Started by avina-shop-images-warm.timer and once by hand after a deploy:
#   sudo systemctl start avina-shop-images-warm
# Install: sudo cp avina-shop-images-warm.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now avina-shop-images-warm.timer
# Undo:    sudo systemctl disable --now avina-shop-images-warm.timer
#          sudo rm /etc/systemd/system/avina-shop-images-warm.{service,timer} && sudo systemctl daemon-reload

[Unit]
Description=Avina shop — warm the image cache
After=avina-shop.service
Requires=avina-shop.service

[Service]
Type=oneshot
User=avina
Group=avina
WorkingDirectory=/opt/avina-shop
EnvironmentFile=/opt/avina-shop/.env
# the script only calls the shop over HTTP and reads the product list; the shop does the resizing
ExecStart=/usr/bin/env node scripts/warm-images.mjs http://127.0.0.1:3861
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=20%
TimeoutStartSec=1h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
