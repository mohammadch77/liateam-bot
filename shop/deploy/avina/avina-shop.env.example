# Avina shop on the shared server: /opt/avina-shop/.env (owner avina, chmod 600). Template: no real value
# in it; fill in on the server only, never in the repository. The app checks all of them at start-up and stops
# with a list of names (never values) when one is missing or invalid.
# Optional variables are commented out: an EMPTY value is not «unset» (an empty number reads as 0 — e.g. a 0% margin —
# and an empty secret is refused), so uncomment a line only to give it a real value. Full description: shop/README.md
# «متغیرهای محیطی». [secret] = keep only in this file.

# ── App ──
# staging | production
APP_ENV=
# Must be 3861 (avina-shop.service also sets it; nginx proxies to 127.0.0.1:3861).
PORT=3861
# The shop's app role (deploy/shop-db-roles.sql): postgres://<role>:<password>@127.0.0.1:5432/<database> [secret]
DATABASE_URL=
# Schema of the shop's own tables: shop_staging for staging (must end in _staging), shop for production.
DB_SCHEMA=
# Optional (defaults): DB_POOL_MAX=5 · DB_STATEMENT_TIMEOUT_MS=10000 · LOG_LEVEL=info
# Small server: keep the pool small.
DB_POOL_MAX=5

# ── Brand ──
# Required: the Persian name shown everywhere (e.g. in titles and «مجله …»).
BRAND_NAME=
# Optional: Latin name; support phone shown in the top bar after «پیگیری سفارش» and in the phone menu (tel: link;
# empty = not shown). Only on the server, never in the repository.
BRAND_LATIN=
SUPPORT_PHONE=

# ── Sign-in ──
# HMAC key for the SMS codes, 32+ random characters: openssl rand -hex 32. Its own value per environment. [secret]
AUTH_SECRET=
# Session lifetime in days (1–90; default 30).
# SESSION_TTL_DAYS=
# 1 = Secure cookies; the site must be on HTTPS (required in production).
COOKIE_SECURE=1
# 1 = behind nginx: the client IP comes from X-Real-IP (per-IP limits). Only with the nginx config of this folder.
TRUST_PROXY=1

# ── Prices (percent) ──
# Partner mode (default): the discount shown to customers is capped at this percent (default 4, the number Liateam
# announces). Other modes: Liateam's discount to our account up to this is our margin; only the rest passes on.
# OUR_BASE_MARGIN_PERCENT=
# Cap of the customer's total discount per product (default 30).
# DISCOUNT_MAX_PERCENT=
# The discount mode until an admin saves one in /admin/settings: partner (default) | consumer | beyond_base.
# DEFAULT_DISCOUNT_MODE=
# Floor: purchase price + this percent; no discount or pack goes below (recommended 1).
DISCOUNT_MIN_MARGIN_PERCENT=1

# ── Sync bot → shop ──
# Same value as the bot's SHOP_REVALIDATE_SECRET, 32+ characters; commented out = the endpoint is off. [secret]
# The bot's SHOP_REVALIDATE_URL is then http://127.0.0.1:3861/api/internal/revalidate
# REVALIDATE_SECRET=

# ── SMS ──
# dev (codes only in the log; refused in production) or kavenegar
SMS_PROVIDER=
# Required with kavenegar. [secret]
# KAVENEGAR_API_KEY=
# Required with kavenegar: an approved «verify» template with %token.
# KAVENEGAR_OTP_TEMPLATE=

# ── Database migrations ──
# Not here on purpose: MIGRATION_DATABASE_URL (the schema owner role) is given only in the one-off migrate command
# (README «نصب روی سرور اشتراکی», migration step), so the running service never holds that password.

# ── Image cache warm-up (images:warm) ──
# At most this many pictures resized per run (default 300).
# IMAGES_WARM_MAX=
