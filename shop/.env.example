# liateam-shop environment. On the server these live in /opt/liateam-shop/env/<staging|production>.env
# (chmod 600, owner liateam-shop); locally copy this file to .env.local. Never commit real values.

# development | staging | production
APP_ENV=development
# Listen port, read from the PROCESS environment (systemd EnvironmentFile); a .env file does not change
# the port Next.js binds to. No collisions: dashboard 3847, shop production 3849, shop staging 3850.
PORT=3850
# Role from deploy/shop-db-roles.sql (lia_shop_staging for staging, lia_shop for production).
DATABASE_URL=postgres://lia_shop_staging:CHANGE_ME@127.0.0.1:5432/lia_sync
# Schema for the shop's own tables: shop_staging (staging/dev) or shop (production).
DB_SCHEMA=shop_staging
# Optional
# DB_POOL_MAX=5
# DB_STATEMENT_TIMEOUT_MS=10000
# LOG_LEVEL=info

# ── Brand (the name is not final; never hard-coded) ──
BRAND_NAME=آوینا
BRAND_LATIN=AVINA BEAUTY
SUPPORT_PHONE=

# ── Auth ──
# HMAC key for OTP codes; 32+ random chars: openssl rand -hex 32. Changing it invalidates pending codes only.
AUTH_SECRET=CHANGE_ME_TO_64_HEX_CHARS________________________________
# SESSION_TTL_DAYS=30
# 1 = Secure cookies (HTTPS). Only plain-http local development may set 0; refused in production.
COOKIE_SECURE=1
# 1 behind nginx (client IP from X-Real-IP, used for per-IP rate limits). Never 1 without the proxy.
TRUST_PROXY=0

# ── SMS ──
# dev = codes printed to the server log (refused in production) · kavenegar = real SMS
# Shared with the sync bot (its .env: SHOP_REVALIDATE_SECRET) for POST /api/internal/revalidate; empty = off.
# REVALIDATE_SECRET=
SMS_PROVIDER=dev
# KAVENEGAR_API_KEY=
# Kavenegar «verify» template with %token, approved in the Kavenegar panel
# KAVENEGAR_OTP_TEMPLATE=

# Only for `npm run migrate:*` (the app never uses it): schema owner role from deploy/shop-db-roles-002-migrator.sql.
MIGRATION_DATABASE_URL=postgres://lia_shop_staging_migrator:CHANGE_ME@127.0.0.1:5432/lia_sync
