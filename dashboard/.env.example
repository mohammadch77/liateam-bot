# Read by the dashboard only. Never put the Liateam password or the Telegram token here.
DASHBOARD_USER=admin
# Generate with: npm run hash-password -- 'a long password'
DASHBOARD_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
SESSION_SECRET=
# Same Postgres as the bot. Prefer the restricted lia_dashboard role (see README).
DASHBOARD_DATABASE_URL=postgres://lia_dashboard:CHANGE_ME@localhost:5433/lia_sync
# 1 behind HTTPS (default). Set 0 only for plain-http testing on localhost.
COOKIE_SECURE=1
# Products with 1..N in stock are marked "running low"
NEXT_PUBLIC_LOW_STOCK=10
