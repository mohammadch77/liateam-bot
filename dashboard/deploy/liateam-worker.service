# /etc/systemd/system/liateam-worker.service  - runs the sync on the dashboard's interval + manual runs
[Unit]
Description=Liateam sync worker
After=network.target postgresql.service

[Service]
User=liateam
WorkingDirectory=/opt/liateam-bot/app
# Home of the liateam user (Playwright keeps its files there)
Environment=HOME=/opt/liateam-bot
ExecStart=/usr/bin/env node src/worker.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
