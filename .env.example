LIA_USERNAME=
LIA_PASSWORD=
LIA_LOGIN_URL=https://liateam.ir/
DATABASE_URL=postgres://lia:lia@localhost:5433/lia_sync
# Optional: CHROMIUM_PATH=/usr/bin/chromium (system browser when Playwright cannot download its own)
# Optional: DELAY_MIN_MS=2000 DELAY_MAX_MS=5000 PRICE_JUMP_LIMIT=0.5 LOGIN_HEADFUL=1
# Messenger bots (src/messenger.mjs). Switch each one on/off in the dashboard → Settings.
# Bale: create a bot with @BotFather inside Bale, paste its token. Works directly from Iran.
BALE_BOT_TOKEN=
# Telegram: create with @BotFather. api.telegram.org is filtered in Iran → deploy
# dashboard/deploy/cloudflare-telegram-relay.js and set TELEGRAM_API_BASE to its custom domain.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://tg.yourdomain.com
# TELEGRAM_PROXY=http://127.0.0.1:10809
# Behave like a person: no scheduled runs in these Tehran hours; minimum minutes between any two runs.
# QUIET_HOURS=1-7
# MIN_GAP_MINUTES=20
