LIA_USERNAME=
LIA_PASSWORD=
LIA_LOGIN_URL=https://liateam.ir/
DATABASE_URL=postgres://lia:lia@localhost:5433/lia_sync
# Optional: CHROMIUM_PATH=/usr/bin/chromium (system browser when Playwright cannot download its own)
# Optional: DELAY_MIN_MS=1000 DELAY_MAX_MS=3000 PRICE_JUMP_LIMIT=0.5 LOGIN_HEADFUL=1
# Telegram alerts (create a bot with @BotFather; get chat_id by messaging the bot, then
# opening https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# api.telegram.org is filtered in Iran - use an HTTP proxy (e.g. v2rayN/Clash local port) or your own relay:
# TELEGRAM_PROXY=http://127.0.0.1:10809
# TELEGRAM_API_BASE=https://your-relay.example.com
